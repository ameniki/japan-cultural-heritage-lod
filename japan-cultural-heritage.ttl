ex:WorldCulturalHeritageSite a rdfs:Class ;
    rdfs:label "世界文化遺産"@ja .

ex:WorldHeritageCriterion a rdfs:Class ;
    rdfs:label "世界遺産評価基準"@ja .

ex:dataset a dcat:Dataset ;
    dct:description "Wikidataの文化遺産基準(i)〜(vi)とUNESCO IDを用いて抽出した、日本に関係する世界文化遺産のLOD。"@ja ;
    dct:issued "2026-07-25"^^xsd:date ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:source <https://www.wikidata.org/> ;
    dct:title "日本の世界文化遺産LOD"@ja ;
    dcat:distribution ex:distribution-turtle .

ex:meetsCriterion a owl:ObjectProperty ;
    rdfs:label "該当する世界遺産評価基準"@ja ;
    rdfs:domain ex:WorldCulturalHeritageSite ;
    rdfs:range ex:WorldHeritageCriterion .

