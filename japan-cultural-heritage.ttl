@prefix ex: <https://ameniki.github.io/japan-cultural-heritage-lod/japan-cultural-heritage.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# クラス
ex:WorldHeritageSite a rdfs:Class ;
    rdfs:label "世界文化遺産"@ja .

# プロパティ
ex:registrationYear a rdf:Property ;
    rdfs:label "世界遺産登録年"@ja ;
    rdfs:domain ex:WorldHeritageSite ;
    rdfs:range xsd:gYear .

# インスタンス
ex:himejiCastle a ex:WorldHeritageSite ;
    rdfs:label "姫路城"@ja ;
    schema:addressRegion "兵庫県"@ja ;
    ex:registrationYear "1993"^^xsd:gYear ;
    owl:sameAs <https://www.wikidata.org/entity/Q188754> .

ex:horyuji a ex:WorldHeritageSite ;
    rdfs:label "法隆寺地域の仏教建造物"@ja ;
    schema:addressRegion "奈良県"@ja ;
    ex:registrationYear "1993"^^xsd:gYear ;
    owl:sameAs <https://www.wikidata.org/entity/Q1333799> .

ex:itsukushimaShrine a ex:WorldHeritageSite ;
    rdfs:label "厳島神社"@ja ;
    schema:addressRegion "広島県"@ja ;
    ex:registrationYear "1996"^^xsd:gYear ;
    owl:sameAs <https://www.wikidata.org/entity/Q191763> .

ex:genbakuDome a ex:WorldHeritageSite ;
    rdfs:label "原爆ドーム"@ja ;
    schema:addressRegion "広島県"@ja ;
    ex:registrationYear "1996"^^xsd:gYear ;
    owl:sameAs <https://www.wikidata.org/entity/Q231140> .

ex:sadoGoldMine a ex:WorldHeritageSite ;
    rdfs:label "佐渡島の金山"@ja ;
    schema:addressRegion "新潟県"@ja ;
    ex:registrationYear "2024"^^xsd:gYear ;
    owl:sameAs <https://www.wikidata.org/entity/Q127378385> .
